# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# Model checkpoints (large binary files >2GB)
models/checkpoints/*.safetensors
models/checkpoints/*.ckpt
models/checkpoints/*.pt
models/checkpoints/*.bin
models/ESRGAN/*.pth

# Generated outputs & results (exclude actual generated images from version control)
results/*.png
results/*.jpg
results/*.json
!results/.gitkeep

# Environment variables & API keys
.env
.env.local
*.key

# IDE & OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local smoke / debug artifacts
out*.txt
test_*.png
_patch_*.py

# Pytest cache
.pytest_cache/

# Nested generation / QA artifacts
results/**/*.png
results/**/*.jpg
results/**/*.json
results/run_*.json
!results/.gitkeep
!results/**/.gitkeep
